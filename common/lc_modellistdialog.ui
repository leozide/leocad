<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>lcModelListDialog</class>
 <widget class="QDialog" name="lcModelListDialog">
  <property name="whatsThis">
   <string>&lt;p&gt;&lt;b&gt;Submodels&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Manage the model and its submodels. Create, rename, duplicate, delete, or reorder entries, then choose OK to apply the changes. Cancel discards the list changes; files already exported remain on disk.&lt;/p&gt;&lt;p&gt;Drag list entries to change their order. Use Set Active to switch to the current list item when applying changes.&lt;/p&gt;</string>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>421</width>
    <height>348</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Submodels</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout">
     <item>
      <widget class="QListWidget" name="ModelList">
       <property name="toolTip">
        <string>Select models to manage, or drag them to change their order.</string>
       </property>
       <property name="accessibleName">
        <string>Submodels</string>
       </property>
       <property name="whatsThis">
        <string>&lt;p&gt;&lt;b&gt;Model List&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Select one or more entries for actions such as Rename, Duplicate, Export, or Delete. Drag entries to reorder them. Double-click an entry to apply the list changes and make that entry active.&lt;/p&gt;&lt;p&gt;Model and submodel names must be unique; capitalization alone does not make a name unique.&lt;/p&gt;</string>
       </property>
       <property name="selectionMode">
        <enum>QAbstractItemView::ExtendedSelection</enum>
       </property>
      </widget>
     </item>
     <item>
      <layout class="QVBoxLayout" name="verticalLayout_2">
       <item>
        <widget class="QPushButton" name="NewModel">
         <property name="toolTip">
          <string>Add a new empty submodel.</string>
         </property>
         <property name="text">
          <string>&amp;New...</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="DeleteModel">
         <property name="toolTip">
          <string>Remove the selected entries.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;Delete Submodels&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Remove the selected entries after confirmation. At least one entry must remain. Changes take effect when you accept this dialog.&lt;/p&gt;</string>
         </property>
         <property name="text">
          <string>D&amp;elete...</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="RenameModel">
         <property name="toolTip">
          <string>Choose a unique name for each selected model.</string>
         </property>
         <property name="text">
          <string>&amp;Rename...</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="ExportModel">
         <property name="toolTip">
          <string>Save the selected models to separate LDraw files.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;Export Submodels&lt;/b&gt;&lt;/p&gt;&lt;p&gt;For one selected model, choose its output file. For several selected models, choose an output folder. Export writes files immediately, even if you later cancel this dialog.&lt;/p&gt;&lt;p&gt;A newly created empty model has nothing to export until the list changes have been applied.&lt;/p&gt;</string>
         </property>
         <property name="text">
          <string>Export...</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="DuplicateModel">
         <property name="toolTip">
          <string>Create named copies of the selected models.</string>
         </property>
         <property name="text">
          <string>Duplicate...</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="SetActiveModel">
         <property name="toolTip">
          <string>Switch to the current list item when applying the changes.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;Set Active&lt;/b&gt;&lt;/p&gt;&lt;p&gt;When checked, accepting this dialog makes the current list entry active for editing. When unchecked, the existing active entry is retained if it remains in the list.&lt;/p&gt;</string>
         </property>
         <property name="text">
          <string>Set Active</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Help|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
