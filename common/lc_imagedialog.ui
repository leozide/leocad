<ui version="4.0">
 <class>lcImageDialog</class>
 <widget class="QDialog" name="lcImageDialog">
  <property name="whatsThis">
   <string>&lt;p&gt;&lt;b&gt;Save Image&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Save images of the active model using the current view. Choose a destination file, image dimensions, and the steps to include.&lt;/p&gt;&lt;p&gt;Saving one step produces one image. Saving several steps produces a separate numbered image for each step.&lt;/p&gt;</string>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>545</width>
    <height>180</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Save Image</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QVBoxLayout" name="verticalLayout_2">
     <item>
      <layout class="QHBoxLayout" name="horizontalLayout_2">
       <item>
        <widget class="QLabel" name="label">
         <property name="toolTip">
          <string>Path and file name for the exported image.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;File Name&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Choose an output folder, file name, and image extension, such as .png, .jpg, or .bmp.&lt;/p&gt;&lt;p&gt;When saving several steps, the step number is added before the extension. For example, 'model.png' becomes 'model01.png', 'model02.png', and so on.&lt;/p&gt;</string>
         </property>
         <property name="text">
          <string>File Name:</string>
         </property>
         <property name="buddy">
          <cstring>fileName</cstring>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLineEdit" name="fileName">
         <property name="toolTip">
          <string>Path and file name for the exported image.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;File Name&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Choose an output folder, file name, and image extension, such as .png, .jpg, or .bmp.&lt;/p&gt;&lt;p&gt;When saving several steps, the step number is added before the extension. For example, 'model.png' becomes 'model01.png', 'model02.png', and so on.&lt;/p&gt;</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QToolButton" name="fileNameBrowse">
         <property name="toolTip">
          <string>Choose the image file and format.</string>
