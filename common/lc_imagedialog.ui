         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;File Name&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Choose an output folder, file name, and image extension, such as .png, .jpg, or .bmp.&lt;/p&gt;&lt;p&gt;When saving several steps, the step number is added before the extension. For example, 'model.png' becomes 'model01.png', 'model02.png', and so on.&lt;/p&gt;</string>
         </property>
         <property name="accessibleName">
          <string>Choose Image File</string>
         </property>
