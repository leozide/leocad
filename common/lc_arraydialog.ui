<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>lcArrayDialog</class>
 <widget class="QDialog" name="lcArrayDialog">
  <property name="whatsThis">
   <string>&lt;p&gt;&lt;b&gt;Array&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Create repeated copies of the selected pieces using up to three array dimensions. Each row defines a count, an offset, and a rotation increment.&lt;/p&gt;&lt;p&gt;Counts include the original selection. For example, counts of 3, 2, and 1 create five new copies of each selected piece. Set an offset or rotation to keep copies from overlapping.&lt;/p&gt;</string>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>492</width>
    <height>156</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Array</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout">
     <item>
      <widget class="QGroupBox" name="groupBox_4">
       <property name="whatsThis">
        <string>&lt;p&gt;&lt;b&gt;Dimensions&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Each row controls one array dimension, with a count from 1 to 1000. The product of the three counts includes the original selection. A count of 1 adds no copies along that dimension.&lt;/p&gt;</string>
       </property>
       <property name="title">
        <string>Dimensions</string>
       </property>
       <layout class="QGridLayout" name="gridLayout_8">
        <item row="0" column="0">
         <layout class="QGridLayout" name="gridLayout_9">
          <item row="2" column="0">
           <widget class="QSpinBox" name="count3">
            <property name="toolTip">
             <string>Number of positions in dimension 3, including the original.</string>
            </property>
            <property name="accessibleName">
             <string>Dimension 3 count</string>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>1000</number>
            </property>
           </widget>
          </item>
          <item row="0" column="0">
           <widget class="QSpinBox" name="count1">
            <property name="toolTip">
             <string>Number of positions in dimension 1, including the original.</string>
            </property>
            <property name="accessibleName">
             <string>Dimension 1 count</string>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>1000</number>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QSpinBox" name="count2">
            <property name="toolTip">
             <string>Number of positions in dimension 2, including the original.</string>
            </property>
            <property name="accessibleName">
             <string>Dimension 2 count</string>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>1000</number>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupBox_5">
       <property name="whatsThis">
        <string>&lt;p&gt;&lt;b&gt;Offsets&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Each row sets the X, Y, and Z displacement per step in the corresponding array dimension. Values use the model axes and LDraw units; 20 units equal one stud width. Negative values reverse the direction.&lt;/p&gt;&lt;p&gt;For a straight row spaced one stud apart along X, use a count greater than 1 and an X offset of 20 in the same row.&lt;/p&gt;</string>
       </property>
       <property name="title">
        <string>Offsets</string>
       </property>
       <layout class="QGridLayout" name="gridLayout_10">
        <item row="0" column="1">
         <widget class="QLineEdit" name="offset1y">
          <property name="toolTip">
           <string>Y offset per step in dimension 1, in LDraw units.</string>
          </property>
          <property name="accessibleName">
           <string>Dimension 1 Y offset</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLineEdit" name="offset2x">
          <property name="toolTip">
           <string>X offset per step in dimension 2, in LDraw units.</string>
          </property>
          <property name="accessibleName">
           <string>Dimension 2 X offset</string>
          </property>
         </widget>
        </item>
        <item row="0" column="0">
         <widget class="QLineEdit" name="offset1x">
