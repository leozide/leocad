    <layout class="QVBoxLayout" name="MainLayout">
     <item>
      <layout class="QHBoxLayout" name="outputLayout">
       <item>
        <widget class="QLabel" name="outputLabel">
         <property name="toolTip">
          <string>Path and file name for the rendered image.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;Output Image&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Choose where to save the rendered image and its format, such as PNG, JPEG, or BMP. The output path applies to image rendering; Open in Blender does not use it.&lt;/p&gt;</string>
         </property>
         <property name="text">
          <string>Output:</string>
         </property>
         <property name="buddy">
          <cstring>OutputEdit</cstring>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLineEdit" name="OutputEdit">
         <property name="toolTip">
          <string>Path and file name for the rendered image.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;Output Image&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Choose where to save the rendered image and its format, such as PNG, JPEG, or BMP. The output path applies to image rendering; Open in Blender does not use it.&lt;/p&gt;</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QToolButton" name="OutputBrowseButton">
         <property name="toolTip">
