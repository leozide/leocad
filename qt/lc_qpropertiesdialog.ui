        <widget class="QLabel" name="label_4">
         <property name="toolTip">
          <string>Overall model dimensions along the X, Y, and Z axes.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;Model Measurements&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The dimensions of the model's bounding box are shown in centimeters, inches, and LDraw units (LDU). The values are read-only and include pieces across all steps.&lt;/p&gt;</string>
