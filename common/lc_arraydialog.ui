       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupBox_6">
       <property name="whatsThis">
        <string>&lt;p&gt;&lt;b&gt;Rotations&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Each row sets the rotation increment around the X, Y, and Z model axes, in degrees, for its array dimension. Rotations from all three dimensions are added, then applied in X, Y, Z order before the offset.&lt;/p&gt;&lt;p&gt;Copies rotate around the focused piece origin, or the selection center when no piece has focus. Negative values reverse the rotation.&lt;/p&gt;</string>
       </property>
       <property name="title">
        <string>Rotations</string>
       </property>
       <layout class="QGridLayout" name="gridLayout_11">
        <item row="2" column="2">
         <widget class="QLineEdit" name="rotation3z">
          <property name="toolTip">
           <string>Z rotation per step in dimension 3, in degrees.</string>
          </property>
          <property name="accessibleName">
           <string>Dimension 3 Z rotation</string>
          </property>
         </widget>
        </item>
        <item row="2" column="0">
