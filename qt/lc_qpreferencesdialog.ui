          <item row="15" column="1">
           <widget class="QComboBox" name="HighlightRenderMode">
            <property name="accessibleName">
             <string>Highlight Style</string>
            </property>
            <property name="whatsThis">
             <string>&lt;p&gt;&lt;b&gt;Highlight Style&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Choose how selected pieces and pieces added in the current step are highlighted in the viewport. Outline uses fading outlines in the selection, focus, or new-piece highlight color. Selected pieces also receive a faint fill over obscured portions. Tint and Edges uses tinted faces and colored edges for selection, and colored edges for new pieces.&lt;/p&gt;&lt;p&gt;New-piece highlighting requires Highlight New Pieces. Wireframe views, image exports, and systems without outline support use Tint and Edges.&lt;/p&gt;</string>
            </property>
            <property name="toolTip">
             <string>Choose how selected pieces and new pieces are highlighted in the viewport.</string>
            </property>
            <item>
             <property name="text">
              <string>Outline</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Tint and Edges</string>
             </property>
            </item>
           </widget>
          </item>
